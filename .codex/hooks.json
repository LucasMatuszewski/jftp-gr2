{
  "description": "Review semantic Maven POM edits before execution with two read-only security agents.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import runpy,subprocess; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); runpy.run_path(root+'/.codex/hooks/launch.py',run_name='__main__')\"",
            "timeout": 540,
            "statusMessage": "Checking POM changes and dependency security"
          }
        ]
      }
    ]
  }
}
